# ==========================================
# Git & Version Control
# ==========================================
.git
.gitignore
.gitattributes

# ==========================================
# Security & Secrets (CRITICAL)
# ==========================================
# Never send environment variables or keys to the Docker build context
.env
.env.*
*.pem
*.key

# ==========================================
# Python Backend
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
venv/
env/
.venv/
ENV/
backend/venv/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
nosetests.xml
coverage.xml
backend/tests/

# ==========================================
# Node Frontend
# ==========================================
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs (Docker should build these itself, not copy local builds)
dist/
build/
frontend/dist/
frontend/build/
.eslintcache
.vite/

# ==========================================
# Database & Local Data
# ==========================================
# Prevent copying massive local database volumes into the image
database/data/
postgres_data/
*.sqlite
*.sqlite3
*.db

# ==========================================
# OS & IDE Files
# ==========================================
.DS_Store
__MACOSX/
Thumbs.db
.vscode/
.idea/
*.swp
*.swo